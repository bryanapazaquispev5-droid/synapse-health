rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // This claim is issued only by a trusted administrator, never a profile field.
    function contentAdmin() {
      return signedIn() && request.auth.token.get('contentAdmin', false) == true;
    }

    function boundedText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function optionalDate(value) {
      return value == null || (value is string && value.size() <= 40);
    }

    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'email', 'career', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'career', 'gender',
          'studyStreakDays', 'createdAt', 'updatedAt', 'authProvider', 'photoUrl'])
        && data.uid == uid
        && boundedText(data.name, 100)
        && boundedText(data.career, 100)
        && data.email is string && data.email.size() <= 254
        && ((request.auth.token.firebase.sign_in_provider == 'anonymous'
              && data.email == 'invitado@synapse.app')
          || data.email == request.auth.token.get('email', ''))
        && data.get('gender', 'Hombre') in ['Hombre', 'Mujer']
        && data.get('studyStreakDays', 0) is int
        && data.get('studyStreakDays', 0) >= 0
        && data.createdAt is timestamp
        && data.get('updatedAt', request.time) is timestamp
        && (data.get('photoUrl', null) == null
          || (data.photoUrl is string && data.photoUrl.size() <= 2048
            && data.photoUrl.matches('https://.*')))
        && (data.get('authProvider', null) == null
          || data.authProvider in ['password', 'google.com', 'anonymous']);
    }

    function validAttempt(attempt) {
      return attempt is map
        && attempt.keys().hasAll(['attemptNumber', 'startedAt', 'completedAt',
          'totalEarnedStars', 'totalMaxStars', 'questionAnswers'])
        && attempt.keys().hasOnly(['attemptNumber', 'startedAt', 'completedAt',
          'totalEarnedStars', 'totalMaxStars', 'questionAnswers'])
        && attempt.attemptNumber is int && attempt.attemptNumber >= 1
        && boundedText(attempt.startedAt, 40)
        && optionalDate(attempt.completedAt)
        && attempt.totalEarnedStars is int && attempt.totalEarnedStars >= 0
        && attempt.totalMaxStars is int && attempt.totalMaxStars >= 0
        && attempt.totalEarnedStars <= attempt.totalMaxStars
        && attempt.questionAnswers is map;
    }

    // Practice data is private and self-reported; never authoritative ranking input.
    function validProgress(data, topicId) {
      return data.keys().hasAll(['topicId', 'areaId', 'currentAttemptNumber',
          'activeAttempt', 'history', 'updatedAt'])
        && data.keys().hasOnly(['topicId', 'areaId', 'currentAttemptNumber',
          'activeAttempt', 'history', 'updatedAt'])
        && data.topicId == topicId
        && boundedText(data.areaId, 200)
        && data.currentAttemptNumber is int && data.currentAttemptNumber >= 1
        && validAttempt(data.activeAttempt)
        && data.activeAttempt.attemptNumber == data.currentAttemptNumber
        && data.history is list && data.history.size() <= 3
        && (data.history.size() < 1 || validAttempt(data.history[0]))
        && (data.history.size() < 2 || validAttempt(data.history[1]))
        && (data.history.size() < 3 || validAttempt(data.history[2]))
        && optionalDate(data.updatedAt);
    }

    function validToken(data, tokenId) {
      return data.keys().hasAll(['token', 'platform', 'createdAt', 'updatedAt', 'isWeb'])
        && data.keys().hasOnly(['token', 'platform', 'createdAt', 'updatedAt', 'isWeb'])
        && data.token == tokenId && boundedText(data.token, 1500)
        && data.platform in ['android', 'iOS', 'macOS', 'windows', 'linux', 'fuchsia']
        && data.isWeb is bool
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create: if owner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('studyStreakDays', 0) == 0
        && request.resource.data.get('updatedAt', request.time) == request.time
        && request.resource.data.get('authProvider',
          request.auth.token.firebase.sign_in_provider)
            == request.auth.token.firebase.sign_in_provider;
      allow update: if owner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'career', 'gender', 'photoUrl', 'updatedAt', 'createdAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time)
        && (('createdAt' in resource.data
            && request.resource.data.createdAt == resource.data.createdAt)
          || (!('createdAt' in resource.data)
            && request.resource.data.createdAt == request.time));

      match /quiz_topics_progress/{topicId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validProgress(request.resource.data, topicId);
        allow update: if owner(uid) && validProgress(request.resource.data, topicId)
          && request.resource.data.areaId == resource.data.areaId;
        allow delete: if false;
      }

      match /fcm_tokens/{tokenId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validToken(request.resource.data, tokenId);
      }
    }

    match /medical_areas/{areaId} {
      allow read: if signedIn();
      allow write: if contentAdmin();
      match /topics/{topicId} {
        allow read: if signedIn();
        allow write: if contentAdmin();
        match /cheatsheets/{cheatsheetId} {
          allow read: if signedIn();
          allow write: if contentAdmin();
        }
        match /quizzes/{quizId} {
          allow read: if signedIn();
          allow write: if contentAdmin();
        }
      }
      // Legacy quizzes remain readable during the existing fallback flow.
      match /quizzes/{quizId} {
        allow read: if signedIn();
        allow write: if contentAdmin();
      }
    }

    // Only an IAM-authorized server (Admin SDK) may publish verified ranking data.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
