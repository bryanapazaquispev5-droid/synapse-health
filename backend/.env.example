# Non-secret configuration. Credentials are obtained from Secrets Manager.
FIREBASE_PROJECT_ID=replace-with-firebase-project
FIREBASE_CREDENTIAL_SECRET_ARN=replace-with-existing-secret-arn
USER_RATE_LIMIT=30
ALLOWED_ORIGIN=https://synapse.invalid
# Flutter build configuration: empty retains the real Firestore source.
SYNAPSE_API_BASE_URL=

# Public Cognito identifiers; no client secret.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
SYNAPSE_AUTH_PROVIDER=firebase
SYNAPSE_COGNITO_STAGING=false
SYNAPSE_COGNITO_REGION=
SYNAPSE_COGNITO_USER_POOL_ID=
SYNAPSE_COGNITO_CLIENT_ID=

# Opt-in content CRUD: deployment additionally requires EnableFlashcardCrud and EnableCognitoAuth.
FLASHCARDS_TABLE_NAME=
FLASHCARDS_RATE_LIMIT=60

# Opt-in quiz backend requires EnableQuizBackend and EnableCognitoAuth.
QUIZZES_TABLE_NAME=
QUIZ_RESULTS_TABLE_NAME=
QUIZZES_RATE_LIMIT=60

# Explicit Cognito/DynamoDB history and ranking. Default preserves Firebase history.
ACADEMIC_VIEWS_ENABLED=false
