# Lambda recibe credenciales temporales mediante su rol de ejecución.
AWS_REGION=us-east-2
MEDICAL_AREAS_TABLE_NAME=replace-with-stack-medical-areas
TOPICS_TABLE_NAME=replace-with-stack-topics
QUIZZES_TABLE_NAME=replace-with-stack-quizzes
STUDY_NOTES_TABLE_NAME=replace-with-stack-study-notes
USER_PROFILES_TABLE_NAME=replace-with-stack-user-profiles
USER_PROGRESS_TABLE_NAME=replace-with-stack-user-progress
LEADERBOARD_TABLE_NAME=replace-with-stack-leaderboard
RATE_LIMITS_TABLE_NAME=replace-with-stack-rate-limits
COGNITO_USER_POOL_ID=replace-with-user-pool-id
COGNITO_CLIENT_ID=replace-with-public-mobile-client-id
# Límite por usuario: 120 solicitudes por minuto; API Gateway: 5 por segundo.
ALLOWED_ORIGIN=https://synapse.invalid
# URL pública de la API para Flutter; si falta, la app falla de forma segura.
SYNAPSE_API_BASE_URL=
