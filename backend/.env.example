# Non-secret configuration. Credentials are obtained from Secrets Manager.
FIREBASE_PROJECT_ID=replace-with-firebase-project
FIREBASE_CREDENTIAL_SECRET_ARN=replace-with-existing-secret-arn
USER_RATE_LIMIT=30
ALLOWED_ORIGIN=https://synapse.invalid
# Flutter build configuration: empty retains the real Firestore source.
SYNAPSE_API_BASE_URL=
