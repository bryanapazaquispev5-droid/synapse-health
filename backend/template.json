    "HostedDomain": {"Type":"AWS::Cognito::UserPoolDomain","Condition":"Approved","Metadata":{"com.aws.cloudformation.Context":{"why":"Use classic hosted login supported by Lite; no paid managed-login upgrade.","must":["Use Cognito identities for the AWS application.","Public mobile client has no secret."]}},"Properties":{"UserPoolId":{"Ref":"UserPool"},"Domain":{"Fn::Sub":"${AWS::StackName}-${AWS::AccountId}"},"ManagedLoginVersion":1}},
    "StudentGroup": {"Type":"AWS::Cognito::UserPoolGroup","Condition":"Approved","Metadata":{"com.aws.cloudformation.Context":{"why":"Newly confirmed email/password accounts receive the standard student role.","must":["Use Cognito identities for the AWS application.","Public mobile client has no secret."]}},"Properties":{"GroupName":"student","UserPoolId":{"Ref":"UserPool"}}},
