    "LambdaLogs": {"Type":"AWS::Logs::LogGroup","Condition":"Approved","DeletionPolicy":"Retain","UpdateReplacePolicy":"Retain","Metadata":{"com.aws.cloudformation.Context":{"why":"Bound log retention; handler emits request ID and safe error code only.","must":["No external identity-provider credentials or legacy database access.","No provisioned concurrency, NAT, WAF or paid account-plan change."]}},"Properties":{"LogGroupName":{"Fn::Sub":"/aws/lambda/${AWS::StackName}-api"},"RetentionInDays":7}},
