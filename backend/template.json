    "LambdaRole": {"Type":"AWS::IAM::Role","Condition":"Approved","Metadata":{"com.aws.cloudformation.Context":{"why":"Separate table permissions follow catalog, owner state, ranking, and rate-limit access patterns.","must":["No external identity-provider credentials or legacy database access.","No provisioned concurrency, NAT, WAF or paid account-plan change."]}},"Properties":{"AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"lambda.amazonaws.com"},"Action":"sts:AssumeRole"}]},"Policies":[{"PolicyName":"OwnerDataAndLogs","PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:Query"],"Resource":[{"Fn::GetAtt":["MedicalAreasTable","Arn"]},{"Fn::GetAtt":["TopicsTable","Arn"]},{"Fn::GetAtt":["QuizzesTable","Arn"]},{"Fn::GetAtt":["StudyNotesTable","Arn"]}]},{"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:PutItem"],"Resource":{"Fn::GetAtt":["UserProfilesTable","Arn"]},"Condition":{"ForAllValues:StringLike":{"dynamodb:LeadingKeys":["USER#*"]},"Null":{"dynamodb:LeadingKeys":"false"}}},{"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:PutItem","dynamodb:Query"],"Resource":{"Fn::GetAtt":["UserProgressTable","Arn"]},"Condition":{"ForAllValues:StringLike":{"dynamodb:LeadingKeys":["USER#*"]},"Null":{"dynamodb:LeadingKeys":"false"}}},{"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:Query"],"Resource":{"Fn::GetAtt":["LeaderboardTable","Arn"]},"Condition":{"ForAllValues:StringLike":{"dynamodb:LeadingKeys":["LEADERBOARD"]},"Null":{"dynamodb:LeadingKeys":"false"}}},{"Effect":"Allow","Action":["dynamodb:PutItem"],"Resource":[{"Fn::GetAtt":["UserProgressTable","Arn"]},{"Fn::GetAtt":["LeaderboardTable","Arn"]}],"Condition":{"ForAllValues:StringLike":{"dynamodb:LeadingKeys":["USER#*","LEADERBOARD"]},"Null":{"dynamodb:LeadingKeys":"false"},"ForAnyValue:StringEquals":{"dynamodb:EnclosingOperation":["TransactWriteItems"]}}},{"Effect":"Allow","Action":["dyn