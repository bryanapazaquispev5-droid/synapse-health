{
  "name": "synapse-health-aws-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "start": "node src/aws/local-server.mjs",
    "package:aws": "powershell -NoProfile -File scripts/package-aws.ps1",
    "test:aws": "npm run build && node --test test/aws-*.test.mjs test/cognito-*.test.mjs",
    "build": "node scripts/check.mjs && node infra/build-template.mjs",
    "migrate:catalog": "node scripts/migrate-catalog-to-split-tables.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:health": "node --test test/aws-api.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1149.0",
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "aws-jwt-verify": "5.2.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
