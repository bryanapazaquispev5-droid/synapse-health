{
  "name": "synapse-health-aws-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:emulator": "node --test test/emulator.integration.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:health": "npm run build && node --test test/health.smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "typescript": "^5.9.0"
  }
}
