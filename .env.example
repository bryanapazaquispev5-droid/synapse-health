# Plantilla de variables de entorno para Synapse Health
# Copia este archivo como '.env' en tu entorno local y coloca tus llaves privadas.
# NUNCA subas tu archivo '.env' real al repositorio público.

API_BASE_URL=https://api.synapsehealth.internal/v1
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE
FIREBASE_PROJECT_ID=synapse-health-2026